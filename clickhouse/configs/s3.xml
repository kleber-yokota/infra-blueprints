<clickhouse>
    <storage_configuration>
        <disks>
            <garage_s3_base>
                <type>s3</type>
                <endpoint from_env="GARAGE_ENDPOINT" />
                <access_key_id from_env="GARAGE_ACCESS_KEY" />
                <secret_access_key from_env="GARAGE_SECRET_KEY" />
                <use_path_style_url>true</use_path_style_url>
                <region>garage</region>
                <metadata_path>/var/lib/clickhouse/disks/garage_s3_disk/</metadata_path>
                <s3_max_single_part_upload_size>33554432</s3_max_single_part_upload_size>
                <s3_min_upload_part_size>16777216</s3_min_upload_part_size>
            </garage_s3_base>

            <garage_s3_disk>
                <type>cache</type>
                <disk>garage_s3_base</disk>
                <path>/var/lib/clickhouse/disks/garage_s3_disk/cache/</path>
                <max_size>10Gi</max_size>
            </garage_s3_disk>
        </disks>

        <policies>
            <s3_main>
                <volumes>
                    <main>
                        <disk>garage_s3_disk</disk>
                    </main>
                </volumes>
            </s3_main>
        </policies>
    </storage_configuration>
</clickhouse>
